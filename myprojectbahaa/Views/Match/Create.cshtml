@model myprojectbahaa.Models.Match

@{
    ViewData["Title"] = "Add Match";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    body { background-color: #1a1a2e; color: white; }
    .card { background-color: #16213e; border: none; }
    h1 { color: #00d4ff; font-weight: bold; }
    .form-control, .form-select { background-color: #0f3460; color: white; border: 1px solid #00d4ff; }
    .form-control:focus, .form-select:focus { background-color: #0f3460; color: white; }
</style>

<div class="container py-5">
    <div class="text-center mb-4">
        <h1>➕ Add New Match</h1>
    </div>

    <div class="card p-4 mx-auto" style="max-width: 500px;">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label">Player 1</label>
                <select asp-for="Player1Id" class="form-select" required>
                    <option value="">-- Select Player --</option>
                    @foreach (var player in ViewBag.Players)
                    {
                        <option value="@player.Id">@player.Name</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Player 1 Score</label>
                <input asp-for="Score1" type="number" min="0" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Player 2</label>
                <select asp-for="Player2Id" class="form-select" required>
                    <option value="">-- Select Player --</option>
                    @foreach (var player in ViewBag.Players)
                    {
                        <option value="@player.Id">@player.Name</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Player 2 Score</label>
                <input asp-for="Score2" type="number" min="0" class="form-control" required />
            </div>
            <div class="text-center mt-4">
                <button type="submit" class="btn btn-success px-5">✅ Save Match</button>
                <a href="/Match/Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>