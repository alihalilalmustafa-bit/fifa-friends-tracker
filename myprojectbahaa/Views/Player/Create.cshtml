@model myprojectbahaa.Models.Player

@{
    ViewData["Title"] = "Add Player";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    body { background-color: #1a1a2e; color: white; }
    .card { background-color: #16213e; border: none; }
    h1 { color: #00d4ff; font-weight: bold; }
    .form-control { background-color: #0f3460; color: white; border: 1px solid #00d4ff; }
    .form-control:focus { background-color: #0f3460; color: white; }
</style>

<div class="container py-5">
    <div class="text-center mb-4">
        <h1>👤 Add New Player</h1>
    </div>

    <div class="card p-4 mx-auto" style="max-width: 500px;">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Ahmed Al-Rashid" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input asp-for="Username" class="form-control" placeholder="e.g. AhmedR" required />
            </div>
            <div class="text-center mt-4">
                <button type="submit" class="btn btn-success px-5">➕ Add Player</button>
                <a href="/Player/Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>