@model IEnumerable<myprojectbahaa.Models.Match>

@{
    ViewData["Title"] = "All Matches";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    body { background-color: #1a1a2e; color: white; }
    .card { background-color: #16213e; border: none; }
    h1 { color: #00d4ff; font-weight: bold; }
    .win { color: #28a745; font-weight: bold; }
    .loss { color: #dc3545; font-weight: bold; }
    .draw { color: #ffc107; font-weight: bold; }
</style>

<div class="container py-5">
    <div class="text-center mb-4">
        <h1>📋 All Matches</h1>
        <a href="/Match/Create" class="btn btn-success">➕ Add Match</a>
        <a href="/" class="btn btn-secondary ms-2">🏠 Home</a>
    </div>

    <div class="card p-4">
        <table class="table table-hover" style="color:white">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Player 1</th>
                    <th>Score</th>
                    <th>Player 2</th>
                    <th>Result</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var match in Model)
                {
                    <tr>
                        <td>@match.Date.ToString("dd/MM/yyyy")</td>
                        <td>@match.Player1?.Name</td>
                        <td class="text-center">
                            <strong>@match.Score1 - @match.Score2</strong>
                        </td>
                        <td>@match.Player2?.Name</td>
                        <td>
                            @if (match.Score1 > match.Score2)
                            {
                                <span class="win">@match.Player1?.Name Wins! 🏆</span>
                            }
                            else if (match.Score1 < match.Score2)
                            {
                                <span class="win">@match.Player2?.Name Wins! 🏆</span>
                            }
                            else
                            {
                                <span class="draw">Draw 🤝</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>