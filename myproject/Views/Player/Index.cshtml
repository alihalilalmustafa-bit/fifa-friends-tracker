@model IEnumerable<myprojectbahaa.Models.Player>

@{
    ViewData["Title"] = "Players";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    body { background-color: #1a1a2e; color: white; }
    .card { background-color: #16213e; border: none; }
    h1 { color: #00d4ff; font-weight: bold; }
</style>

<div class="container py-5">
    <div class="text-center mb-4">
        <h1>👥 All Players</h1>
        <a href="/Player/Create" class="btn btn-primary">➕ Add New Player</a>
        <a href="/" class="btn btn-secondary ms-2">🏠 Home</a>
    </div>

    <div class="card p-4">
        <table class="table table-hover" style="color:white">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Username</th>
                    <th>Wins</th>
                    <th>Losses</th>
                    <th>Draws</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var player in Model)
                {
                    <tr>
                        <td>@player.Name</td>
                        <td>@@player.Username</td>
                        <td>@player.Wins</td>
                        <td>@player.Losses</td>
                        <td>@player.Draws</td>
                        <td>
                            <a href="/Player/Delete/@player.Id" class="btn btn-sm btn-danger">🗑️ Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>